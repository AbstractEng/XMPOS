{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "paths": {
      "@xmp/core": ["./packages/core/src/index.ts"],
      "@xmp/sdk": ["./packages/sdk/src/index.ts"]
    }
  },
  "include": ["os", "apps", "packages", "examples", "tests", "vite.config.ts"]
}
