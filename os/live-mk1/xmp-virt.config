# XMP add-only fragment for booting the official az01 kernel on QEMU's generic
# "virt" ARM board. It only enables default-off options: everything the official
# configuration enables keeps its value and everything az01_defconfig explicitly
# disables stays off. tools/live-mk1/kernel.mjs audits this after merging.
CONFIG_ARCH_VIRT=y
CONFIG_ARM_PSCI=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_RD_GZIP=y
CONFIG_SND_PROC_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_VIRTIO_BLK=y
CONFIG_GPIO_PL061=y
CONFIG_TMPFS=y
# Live-like emulator devices (emulator kernel only):
# a virtual USB host, so in-guest USB gadgets can stand in for the Live's
# internal controller (09e8:003b) and audio card (09e8:203b) on the host side;
CONFIG_USB_DUMMY_HCD=y
# a virtio GPU, so the session's framebuffer at the Live's 800x1280 can be screenshotted.
CONFIG_DRM_VIRTIO_GPU=y
# a virtio console, so the emulator can carry the control bridge's USB serial
# link (relayed by the Live twin) out to a socket on the Mac.
CONFIG_VIRTIO_CONSOLE=y
