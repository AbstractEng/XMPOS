    foreach(symbol malloc calloc realloc free pthread_mutex_lock open read write fwrite socket send recv)
      target_link_options(${target} PRIVATE "-Wl,--wrap=${symbol}")
    endforeach()
  endforeach()
  add_test(NAME callback_audit_canary_linux COMMAND xmp_engine_test canary)
